# PostmortemIQ Environment Variables

# Groq API Key (get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Model Configuration
PRIMARY_MODEL=llama-3.1-8b-instant
FALLBACK_MODEL=mixtral-8x7b-32768
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Paths (defaults work for local dev)
DATA_DIR=data
CHROMA_DIR=data/chroma
GRAPH_PATH=data/knowledge_graph.json
SQLITE_PATH=data/postmortem.db

# Rate Limiting
GROQ_RPM=30
GROQ_RETRY_ATTEMPTS=3

# Retrieval Settings
VECTOR_TOP_K=5
GRAPH_MAX_HOPS=2
CHUNK_SIZE=512
CHUNK_OVERLAP=50
